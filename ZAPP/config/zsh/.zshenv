#====================
# Global Exports
#====================
export PATH="${PATH}:${HOME}/.local/bin:${HOME}/Scipts"
export EDITOR="nvim"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_DATA_HOME="${HOME}/.local/share"
export YAZI_CONFIG_HOME="${ZAPP_PATH}/config/yazi"
export KITTY_CONFIG_DIRECTORY="${ZAPP_PATH}/config/kitty"
#====================
# Global Funtions
#====================
source "${ZDOTDIR}/.zshfuncs"

