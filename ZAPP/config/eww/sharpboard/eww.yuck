(defpoll BRAIN
    :interval "0.0333s"
    '../scripts/animations/brain/brain'
)
(defpoll EYES
    :interval "0.0333s"
    '../scripts/animations/eyes/eyes'
)
(defpoll DNA
    :interval "0.0333s"
    '../scripts/animations/dna/dna'
)
(defpoll FETCH
    :interval "5s"
    'fastfetch -j 2> /dev/null'
)
(defpoll network_animation
    :interval "1s"
    "../scripts/actions animate 1000000 '󰈔  ' '-󰈔 ' '--󰈔' ' -󰈔' '  -' "
)
(defpoll bluetooth_spinner_animation
    :interval "0.2s"
    "../scripts/actions animate 200000 '' '' '' '' '' '' "
)
(deflisten CAVA
    '../scripts/cava_sharpboard'
)

; updated via an external daemon 
; to stop eww from waiting for the command 
; to finish and hitch in the process.
(defvar MAXIMA '')

(defwindow sharpboard
    :monitor 0
    :geometry (geometry
        :x "0px"
        :y "0px"
        :anchor "center center"
    )
    :stacking "fg"
    :exclusive false
    (structure)
)
(defwidget structure []
    (box
        :class 'structure'
        :space-evenly false
        :orientation 'v'
        :spacing 6
        (box
            :class 'h-box1'
            :space-evenly false
            (brain)
            (cpu)
            (eyes)
            (gpu)
        )
        (box
            :class 'h-box2'
            :space-evenly false
            (temp)
            (memory-storage)
            (dna)
        )
        (box
            :class 'h-box3'
            :space-evenly false
            (music)
            (cava)
            (net)
            (bt)
        )
    )
)
; BRAIN {{{
(defwidget brain []
    (box
        :orientation "v"
        :space-evenly false
        (label
            :justify 'center'
            :class 'brain'
            :text '${BRAIN}'
        )
        (label
            :class 'brain-label'
            :text '────[Prefrontal cortex]────'
        )
    )
)
;}}}

; EYES {{{
(defwidget eyes []
    (box
        :orientation "h"
        :space-evenly false
        (label
            :class 'eyes-label'
            :text '────────[Visual cortex]────────'
            :angle 90
        )
        (label
            :class 'eyes'
            :text '${EYES}'
        )
    )
)
;}}}

; CPU {{{
(defwidget cpu []
    (box
        :class 'cpu'
        :orientation 'v'
        :space-evenly false
        :spacing 4
        (box
            :orientation 'v'
            :space-evenly false
            (for core in "${EWW_CPU.cores}"
                (box
                    :space-evenly false
                    (label
                        :class 'cpu-idx'
                        :xalign 0
                        :text "[${jq(core,'.core | ltrimstr("cpu")','r')}]"
                    )
                    (progress
                        :class 'cpu-progress'
                        :value "${core.usage}"
                        :orientation "h"
                        :valign "center"
                    )
                    (label
                        :class 'cpu-per-usage'
                        :xalign 1
                        :text "${core.usage}%"
                    )
                )
            )
        )
        (box 
            :class 'cpu-footer'
            (label
                :class 'cpu-usage'
                :text "[avg] ${round(EWW_CPU.avg,4)}%"
            )
            (label
                :class 'cpu-freq'
                :text "${jq(EWW_CPU,'
                .cores | ( map(.freq) | add) / length | 
                tostring | split(".")[0] | "[freq] " + . + "MHz"
                ','r')}"
            )
        )
        (label
            :class 'cpu-name'
            :text "${jq(FETCH,'.[] | select(.type == "CPU") | .result.cpu','r')}"
        )
    )
)
;}}}

; GPU {{{
(defwidget gpu [] 
    (scroll
        :hscroll true
        :width 110
        (box 
            :class 'gpu'
            :space-evenly false
            
            (for gpu in "${MAXIMA.gpu}" 
                (box
                    :spacing 2
                    :space-evenly false
                    (box
                        :class "gpu-name"
                        :orientation "v"
                        :space-evenly false
                        :spacing 4
                        (literal
                            :content {gpu.temp != '' ?
                            '
                            (label
                                :vexpand true
                                :text "│${gpu.temp}°C"
                                :angle 90
                            )
                            ':
                            ''}
                        )
                        (label
                            :vexpand true
                            :text "${jq(gpu,'
                            # selective stripping
                            .name | split("[UHD Graphics]")[0]
                            ','r')}"
                            :angle 90
                        )
                    )
                    (literal
                        :content {gpu.usage != '' ?
                        '
                        (box
                            :orientation "v"
                            :space-evenly false
                            :spacing 8
                            :vexpand true
                            (label
                                :class "gpu-usage"
                                :text "${gpu.usage}%"
                                :angle 90
                                :yalign "0"
                                :vexpand true
                            )
                            (progress
                                :class "gpu-progress"
                                :value "${gpu.usage}"
                                :orientation "v"
                                :flipped true
                                :halign "center"
                            )
                            (label
                                :class "gpu-usage-icon"
                                :text ""
                                :yalign "1"
                            )
                        )
                        ':''}
                    )
                    (literal
                        :content {gpu.vram_usage != '' ?
                        '
                        (box
                            :orientation "v"
                            :space-evenly false
                            :spacing 8
                            :vexpand true
                            (label
                                :class "gpu-vram-usage"
                                :text "${round(gpu.vram_usage / gpu.vram_total * 100,0)}%"
                                :angle 90
                                :yalign "0"
                                :vexpand true
                            )
                            (progress
                                :class "gpu-progress"
                                :value "${gpu.vram_usage / gpu.vram_total * 100}"
                                :orientation "v"
                                :flipped true
                                :halign "center"
                            )
                            (label
                                :class "gpu-vram-usage-icon"
                                :text ""
                                :yalign "1"
                            )
                        )
                        ':''}
                    )
                )
            )
        )
    )
)
;}}}

; TEMP {{{
(defwidget temp []
    (box
        :orientation 'v'
        :space-evenly false
        (box
            :class 'temp'
            :orientation 'v'
            (for sens in "${jq(EWW_TEMPS,'to_entries')}"
                (box
                    :space-evenly false
                    :hexpand true
                    :spacing 8
                    (label
                        :class "temp-key"
                        :text "${sens.key}"
                        :truncate true
                    )
                    (label
                        :class "${jq(sens,'
                        if .value | tonumber <= 45 then 
                            "temp-value low"
                        elif .value | tonumber <= 80 then 
                            "temp-value mid"
                        elif .value | tonumber <= 100 then 
                            "temp-value high"
                        else 
                            "temp-value"
                        end
                        ','r')}"
                        :text "${floor(sens.value)}°C"
                        :halign "end"
                        :hexpand true
                    )
                )
            )
        )
        (label
            :class "temp-label"
            :text '───────[Somatosensory Cortex]───────'
        )
    )
)
;}}}

; MEMORY-STORAGE {{{
(defwidget memory-storage []
    (box 
        :orientation 'v'
        :space-evenly false
        :spacing 4
        (label
            :class "mem-storage-label"
            :text '───────────────────────[Hippocampus]───────────────────────'
        )
        (box 
            :orientation 'v'
            :space-evenly false
            :class 'mem'
            (label
                :class 'mem-header'
                :text "Memory"
                :hexpand true
                :xalign 0
            )
            (scroll
                :vscroll true
                :height 38
                (box 
                    :class 'mem-info'
                    :space-evenly false
                    :hexpand true
                    (box 
                        :hexpand true
                        :orientation 'v'
                        (label
                            :text "mem"
                            :halign "start"
                        )
                        (label
                            :text "swap"
                            :halign "start"
                        )
                    )
                    (box 
                        :orientation 'v'
                        (label
                            :text "${round(jq(EWW_RAM,'
                            .used_mem / (1024 * 1024 * 1024)
                            ','r'),2)}"
                        )
                        (label
                            :text "${round(jq(EWW_RAM,'
                            (.total_swap - .free_swap) / (1024 * 1024 * 1024)
                            ','r'),2)}"
                        )
                    )
                    (box 
                        :orientation 'v'
                        (label
                            :text "/"
                        )
                        (label
                            :text "/"
                        )
                    )
                    (box 
                        :orientation 'v'
                        (label
                            :text "${round(jq(EWW_RAM,'
                            .total_mem / (1024 * 1024 * 1024)
                            ','r'),2)} GiB"
                        )
                        (label
                            :text "${round(jq(EWW_RAM,'
                            .total_swap / (1024 * 1024 * 1024)
                            ','r'),2)} GiB"
                        )
                    )
                    (box 
                        :hexpand true
                        :orientation 'v'
                        (label
                            :text "${round(EWW_RAM.used_mem_perc,2)}%"
                            :halign "end"
                        )
                        (label
                            :text "${round(jq(EWW_RAM,'
                            ((.total_swap - .free_swap) / .total_swap) /
                            (1024 * 1024 * 1024 * 100 )
                            ','r'),2)}%"
                            :halign "end"
                        )
                    )
                )
            )
        )
        (box 
            :orientation 'v'
            :space-evenly false
            :class 'storage'
            (label
                :text "Storage"
                :hexpand true
                :xalign 0
                :class 'storage-header'
            )
            (scroll
                :vscroll true
                :height 38
                (box
                    :class 'storage-info'
                    :space-evenly false
                    :hexpand true
                    (box
                        :orientation 'v'
                        :hexpand true
                        (for disk in "${jq(EWW_DISK,'. | keys')}"
                            (label
                                :text "${disk}"
                                :halign "start"
                            )
                        )
                    )
                    (box
                        :orientation 'v'
                        (for disk in "${jq(EWW_DISK,'. | to_entries')}"
                            (label
                                :text "${round(jq(disk.value,'
                                .used / (1024 * 1024 * 1024)
                                ','r'),2)}"
                            )

                        )
                    )
                    (box
                        :orientation 'v'
                        (for disk in "${jq(EWW_DISK,'. | to_entries')}"
                            (label
                                :text "/"
                            )

                        )
                    )
                    (box
                        :orientation 'v'
                        (for disk in "${jq(EWW_DISK,'. | to_entries')}"
                            (label
                                :text "${round(jq(disk.value,'
                                .total / (1024 * 1024 * 1024)
                                ','r'),2)} GiB"
                            )

                        )
                    )
                    (box
                        :orientation 'v'
                        :hexpand true
                        (for disk in "${jq(EWW_DISK,'. | to_entries')}"
                            (label
                                :text "${round(disk.value.used_perc,2)}%"
                                :halign "end"
                            )
                        )
                    )
                )
            )
        )
        (box
            :space-evenly false
            :class 'diskio'
            :orientation 'v'
            (box
                :space-evenly false
                :class 'diskio-header'
                (label
                    :text "[DEV]"
                    :xalign 0
                    :width 80
                )
                (label
                    :text "[READ]"
                    :xalign 1
                    :width 100
                    :class 'diskio-header-label'
                )
                (label
                    :text "[WRITE]"
                    :xalign 1
                    :width 100
                    :class 'diskio-header-label'
                )
                (label
                    :text "[TOTAL]"
                    :xalign 1
                    :width 100
                    :class 'diskio-header-label'
                )
                (label
                    :text "[RIO]"
                    :xalign 1
                    :width 70
                    :class 'diskio-header-label'
                )
                (label
                    :text "[WIO]"
                    :xalign 1
                    :width 70
                    :class 'diskio-header-label'
                )
            )
            (scroll
                :vscroll true
                :height 68
                (box
                    :space-evenly false
                    :orientation 'v'
                    (for dev in "${MAXIMA.disk}" 
                        (box
                            :space-evenly false
                            (label
                                :xalign 0
                                :width 80
                                :text "${dev.device}"
                            )
                            (label
                                :xalign 1
                                :width 100
                                :text "${round(jq(dev,'
                                if .read_kibps >= 1024 then 
                                    .read_kibps / 1024 
                                elif .read_kibps >= (1024 * 1024) then 
                                    .read_kibps / (1024 * 1024)
                                else
                                    .read_kibps 
                                end
                                ','r'),2)} ${jq(dev,'
                                if .read_kibps >= 1024 then 
                                    "Mps"
                                elif .read_kibps >= (1024 * 1024) then 
                                    "Gps"
                                else
                                    "Kps"
                                end
                                ','r')}"
                            )
                            (label
                                :width 100
                                :xalign 1
                                :text "${round(jq(dev,'
                                if .write_kibps >= 1024 then 
                                    .write_kibps / 1024 
                                elif .write_kibps >= (1024 * 1024) then 
                                    .write_kibps / (1024 * 1024)
                                else
                                    .write_kibps 
                                end
                                ','r'),2)} ${jq(dev,'
                                if .write_kibps >= 1024 then 
                                    "Mps"
                                elif .write_kibps >= (1024 * 1024) then 
                                    "Gps"
                                else
                                    "Kps"
                                end
                                ','r')}"
                            )
                            (label
                                :width 100
                                :xalign 1
                                :text "${round(jq(dev,'
                                if .total_kibps >= 1024 then 
                                    .total_kibps / 1024 
                                elif .total_kibps >= (1024 * 1024) then 
                                    .total_kibps / (1024 * 1024)
                                else
                                    .total_kibps 
                                end
                                ','r'),2)} ${jq(dev,'
                                if .total_kibps >= 1024 then 
                                    "Mps"
                                elif .total_kibps >= (1024 * 1024) then 
                                    "Gps"
                                else
                                    "Kps"
                                end
                                ','r')}"
                            )
                            (label
                                :width 70
                                :xalign 1
                                :text "${dev.read_iops} IOps"
                            )
                            (label
                                :width 70
                                :xalign 1
                                :text "${dev.write_iops} IOps"
                            )
                        )
                    )
                )
            )
        )
    )
)
;}}}

; DNA {{{
(defwidget dna [] 
    (box
        :class "dna"
        (overlay
            (label
                :text "${DNA}"
            )
            (box
                :space-evenly false
                :class 'dna-overlay'
                (box
                    :hexpand true
                    :orientation 'v'
                    :space-evenly false
                    (label
                        :text "USER: "
                        :xalign 1
                    )
                    (label
                        :text "OS: "
                        :xalign 1
                    )
                    (label
                        :text "Kernel: "
                        :xalign 1
                    )
                    (label
                        :text "Packages: "
                        :xalign 1
                    )
                    (label
                        :text "WM: "
                        :xalign 1
                    )
                )
                (box
                    :orientation 'v'
                    :hexpand true
                    :space-evenly false
                    (label
                        :xalign 0
                        :text "${jq(FETCH,'
                        .[] | select(.type == "Title") | .result.userName
                        ','r')}"
                    )
                    (label
                        :xalign 0
                        :text "${jq(FETCH,'
                        .[] | select(.type == "OS") | .result.name
                        ','r')}"
                    )
                    (label
                        :xalign 0
                        :text "${jq(FETCH,'
                        .[] | select(.type == "Kernel") | .result.release
                        ','r')}"
                    )
                    (label
                        :xalign 0
                        :text "${jq(FETCH,'
                        .[] | select(.type == "Packages") | .result.all
                        ','r')}"
                    )
                    (label
                        :xalign 0
                        :text "${jq(FETCH,'
                        .[] | select(.type == "WM") | .result.prettyName
                        ','r')}"
                    )
                )
            )
        )
    )
)
;}}}

; MUSIC {{{
(defwidget music []
    (box
        :class 'music'
        :space-evenly false
        :spacing 4
        (box
            :orientation 'v'
            :space-evenly false
            (image
                :class 'music-albumart'
                :path "${MAXIMA.music.albumart}"
                :image-width 197
            )
        )
        (box
            :orientation 'v'
            :space-evenly false
            :spacing 4
            (label
                :class 'music-title'
                :text "${MAXIMA.music.scroll_title}"
            )
            (label
                :class 'music-artist'
                :text "${MAXIMA.music.scroll_artist}"
            )
            (box
                :class 'music-nav'
                :space-evenly false
                :spacing 4
                (eventbox
                    :class "music-nav-previous hover-button"
                    (button
                        :onclick "
                        ../scripts/actions \
                        music  \
                        prev"
                        (label 
                            :text "󰒮"
                        )
                    )
                )
                (eventbox
                    :class "${jq(MAXIMA.music,'
                    if .state == "Pause" then 
                        "music-nav-play hover-button"
                    else
                        "music-nav-pause hover-button"
                    end
                    ','r')}"
                    (button
                        :onclick "
                        ../scripts/actions \
                        music  \
                        togglepause"
                        (label 
                            :text "${jq(MAXIMA.music,'
                            if .state == "Pause" then 
                                ""
                            else
                                ""
                            end
                            ','r')}"
                        )
                    )
                )
                (eventbox
                    :class "music-nav-next hover-button"
                    (button
                        :onclick "
                        ../scripts/actions \
                        music  \
                        next"
                        (label 
                            :text "󰒭"
                        )
                    )
                )
                (box
                    :orientation "h"
                    :spacing 4
                    (box
                        :orientation "v"
                        :spacing 4
                        (eventbox
                            :class "${jq(MAXIMA.music,'
                            if .repeat then 
                                "music-nav-repeat hover-button"
                            else 
                                "music-nav-norepeat hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "
                                ../scripts/actions \
                                music  \
                                togglerepeat"
                                (label 
                                    :text ""
                                )
                            )
                        )
                        (eventbox
                            :class "${jq(MAXIMA.music,'
                            if .random  then 
                                "music-nav-random hover-button"
                            else 
                                "music-nav-norandom hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "
                                ../scripts/actions \
                                music  \
                                togglerandom"
                                (label 
                                    :text ""
                                )
                            )
                        )
                    )
                    (box
                        :orientation "v"
                        :spacing 4
                        (eventbox
                            :class "${jq(MAXIMA.music,'
                            if .single == "On" then
                                "music-nav-single hover-button"
                            elif .single == "Oneshot" then
                                "music-nav-oneshot hover-button"
                            elif .single == "Off" then
                                "music-nav-nosingle hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "
                                ../scripts/actions \
                                music  \
                                togglesingle"
                                (label 
                                    :text "󰑊"
                                )
                            )
                        )
                        (eventbox
                            :class "${jq(MAXIMA.music,'
                            if .consume == "On" then
                                "music-nav-single hover-button"
                            elif .consume == "Oneshot" then
                                "music-nav-oneshot hover-button"
                            elif .consume == "Off" then
                                "music-nav-nosingle hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "
                                ../scripts/actions \
                                music  \
                                toggleconsume"
                                (label 
                                    :text "󰆴"
                                )
                            )
                        )
                    )
                )
            )
            (box
                :class "audio"
                :orientation "v"
                :space-evenly false
                (box
                    :class "music-nav-scale"
                    :orientation "h"
                    :space-evenly false
                    :spacing 8
                    (label
                        :hexpand true
                        :xalign 1
                        :class "music-nav-scale-icon"
                        :text "󰎇"
                    )
                    (scale
                        :valign 'center'
                        :value "${MAXIMA.music.elapsed.secs}"
                        :min 0
                        :max "${MAXIMA.music.duration.secs}"
                        :onchange "
                        ../scripts/actions \
                        music  \
                        seek \
                        {}
                        "
                    )
                )
                (box
                    :orientation "h"
                    :class "audio-sink"
                    :space-evenly false
                    :spacing 8
                    (label
                        :hexpand true
                        :xalign 1
                        :class "audio-sink-icon"
                        :text "${jq(MAXIMA.volume,'
                        if .vol_sink != "null" then
                            if .is_mute_sink then 
                                "󰝟"
                            else
                                if .vol_sink == 0.0 then 
                                    "󰖁"
                                elif .vol_sink <= 0.3 then 
                                    "󰕿"
                                elif .vol_sink <= 0.6 then 
                                    "󰖀"
                                else 
                                    "󰕾"
                                end
                            end 
                        else 
                            "null"
                        end
                    ','r')}"
                    )
                    (scale
                        :value "${ceil(MAXIMA.volume.vol_sink * 100)}"
                        :onchange "
                        ../scripts/actions \
                        audio  \
                        set_volume \
                        sink \
                        {}
                        "
                    )
                )
                (box
                    :orientation "h"
                    :class "audio-source"
                    :space-evenly false
                    :spacing 8
                    (label
                        :class "audio-source-icon"
                        :hexpand true
                        :xalign 1
                        :text "${jq(MAXIMA.volume,'
                        if .is_mute_source then 
                            "󰍭"
                        else 
                            "󰍬"
                        end
                        ','r')}"
                    )
                    (scale
                        :value "${ceil(MAXIMA.volume.vol_source * 100)}"
                        :onchange "
                        ../scripts/actions \
                        audio  \
                        set_volume \
                        source \
                        {}
                        "
                    )
                )
            )
        )
    )
)
;}}}

; NET {{{
(defwidget net []
    (box
        :class "net"
        (scroll
            :hscroll true
            :width 300
        (box
            :spacing 8
            (for dev in "${MAXIMA.net}"
                (box
                    :class 'net-device'
                    (box 
                        :orientation "v"
                        :space-evenly false
                        (box
                            :spacing 8
                            :class 'net-device-name'
                            (label
                                :halign "start"
                                :text "DEVICE: ${dev.dev}"
                            )
                        )
                        (box
                            :spacing 8
                            :space-evenly false
                            :class 'net-device-states'
                            (label
                                :text "[${dev.state}]"
                                :class "${jq(dev,'
                                if .state == "UP" then
                                    "net-device-up"
                                else 
                                    "net-device-down"
                                end
                                ','r')}"
                            )
                            (label
                                :text "[${dev.link_state}]"
                                :class "${jq(dev,'
                                if .link_state == "UP" then
                                    "net-device-up"
                                else 
                                    "net-device-down"
                                end
                                ','r')}"
                            )
                        )
                        (scroll
                            :vscroll true
                            :height 130
                            :width 300
                        (box
                            :orientation 'v'
                            :space-evenly false
                        (for ip_addr in "${dev.ip_addr}"
                            (box 
                                :class 'net-device-ip'
                                :space-evenly false
                                :spacing 8
                                (label
                                    :text "IP:"
                                )
                                (label
                                    :text "${ip_addr}"
                                )
                            )
                        )
                        (for gate in "${dev.gate}"
                            (box 
                                :space-evenly false
                                :class 'net-device-gate'
                                :spacing 8
                                (label
                                    :text ""
                                )
                                (label
                                    :text "${gate[0]} "
                                )
                                (label
                                    :width 40
                                    :xalign 1
                                    :text "${network_animation}"
                                )
                                (label
                                    :hexpand true
                                    :xalign 1
                                    :text "${gate[1]}"
                                )
                            )
                        )
                        (box 
                            :space-evenly false
                            :spacing 8
                            :class 'net-device-speed'
                            (label
                                :text "󰓅"
                            )
                            (label
                                :text "${jq(dev,'
                                if .net_down_speed | tonumber > 0 then
                                    .net_down_speed | tonumber | . / 1024 | ceil
                                else
                                    .net_down_speed
                                end
                                ','r')} KiB  ${jq(dev,'
                                if .net_up_speed | tonumber > 0 then
                                    .net_up_speed | tonumber | . / 1024 | ceil
                                else
                                    .net_up_speed
                                end
                                ','r')} KiB "
                            )
                        )
                        )
                        )
                    )
                )
            )
        )
        )
    )
)
;}}}

; BT {{{
(defwidget bt []
    (box 
        :class "bt"
        (scroll
            :vscroll true
            :width 295
        (box
            :orientation "v"
            :spacing 4
            :space-evenly false
            (for ctrl in "${MAXIMA.bt.controllers}"
                (box
                    :orientation "v"
                    :class "bt-controllers"
                    :space-evenly false
                    (box
                        :space-evenly false
                        :spacing 8
                        :class "bt-controllers-header"
                        (label
                            :text "${jq(ctrl,'
                            if .is_default == "yes" then 
                                "[D] CONTROLLER:" 
                            else
                                "CONTROLLER:" 
                            end
                            ','r')}"
                        )
                        (label
                            :text "${ctrl.alias}"
                        )
                        (label
                            :text "${jq(ctrl,'
                            if .is_discovering == "yes" then 
                                "${bluetooth_spinner_animation}"
                            else
                                ""
                            end
                            ','r')}"
                        )
                    )
                    (box 
                        :spacing 8
                        :space-evenly false
                        (eventbox
                            :class "${jq(ctrl,'
                            if .is_powered == "yes" then 
                                "bt-on hover-button"
                            else
                                "bt-off hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "${jq(ctrl,'
                                if .is_powered == "yes" then 
                                    "../scripts/actions bt power yes"
                                else
                                    "../scripts/actions bt power no"
                                end
                                ','r')}"
                                (label
                                    :text "Power"
                                )
                            )
                        )
                        (eventbox
                            :class "${jq(ctrl,'
                            if .is_discoverable == "yes" then 
                                "bt-on hover-button"
                            else
                                "bt-off hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "${jq(ctrl,'
                                if .is_discoverable == "yes" then 
                                    "../scripts/actions bt discoverable yes"
                                else
                                    "../scripts/actions bt discoverable no"
                                end
                                ','r')}"
                                (label
                                    :text "Discoverable"
                                )
                            )
                        )
                        (eventbox
                            :class "${jq(ctrl,'
                            if .is_pairable == "yes" then 
                                "bt-on hover-button"
                            else
                                "bt-off hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "${jq(ctrl,'
                                if .is_pairable == "yes" then 
                                    "../scripts/actions bt pairable yes"
                                else
                                    "../scripts/actions bt pairable no"
                                end
                                ','r')}"
                                (label
                                    :text "Pairable"
                                )
                            )
                        )
                    )
                )
            )
            (for dev in "${MAXIMA.bt.devices}"
                (box 
                    :orientation "v"
                    :class "bt-devices"
                    :space-evenly false
                    (box 
                        :space-evenly false
                        :class "bt-devices-header"
                        :spacing 4
                        (label
                            :text "${jq(dev,'
                            if .is_audio_device == "yes" then 
                                "󰋋" 
                            else
                                "󰂯" 
                            end
                            ','r')} "
                        )
                        (label
                            :hexpand true
                            :halign "start"
                            :text "${dev.name} "
                            :limit-width 20
                        )
                        (label
                            :halign "start"
                            :text "${dev.name}"
                            :text "${jq(dev,'
                            if .battery_perc != null then 
                                .battery_perc + "% 󰥈" 
                            else
                                "" 
                            end
                            ','r')} "
                        )
                        (eventbox 
                            :class "${jq(dev,'
                            if .is_paired == "yes" then 
                                "bt-remove"
                            else
                                ""
                            end
                            ','r')}"
                            (button
                                :onclick "
                                ../scripts/actions \
                                bt remove yes ${dev.mac_addr}"
                                (label
                                    :text "${(dev.is_paired == 'yes' )?' ':''}"
                                )
                            )
                        )
                    )
                    (box 
                        :orientation "h"
                        :space-evenly false
                        :spacing 8
                        (eventbox 
                            :class "${jq(dev,'
                            if .is_paired == "yes" then 
                                "bt-on hover-button"
                            else
                                "bt-off hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "
                                ../scripts/actions \
                                bt pair yes ${dev.mac_addr}"
                                (label
                                    :text "Pair"
                                )
                            )
                        )
                        (eventbox 
                            :class "${jq(dev,'
                            if .is_trusted == "yes" then 
                                "bt-on hover-button"
                            else
                                "bt-off hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "${jq(dev,'
                                if .is_trusted == "yes" then
                                    "../scripts/actions bt trust yes " + 
                                    (.mac_addr | tostring)
                                else
                                    "../scripts/actions bt trust no " + 
                                    (.mac_addr | tostring)
                                end
                                ','r')}"
                                (label
                                    :text "Trust"
                                )
                            )
                        )
                        (eventbox 
                            :class "${jq(dev,'
                            if .is_blocked == "yes" then 
                                "bt-on hover-button"
                            else
                                "bt-off hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "${jq(dev,'
                                if .is_blocked == "yes" then
                                    "../scripts/actions bt block yes " + 
                                    (.mac_addr | tostring)
                                else
                                    "../scripts/actions bt block no " + 
                                    (.mac_addr | tostring)
                                end
                                ','r')}"
                                (label
                                    :text "Block"
                                )
                            )
                        )
                        (eventbox 
                            :class "${jq(dev,'
                            if .is_connected == "yes" then 
                                "bt-on hover-button"
                            else
                                "bt-off hover-button"
                            end
                            ','r')}"
                            (button
                                :onclick "${jq(dev,'
                                if .is_connected == "yes" then
                                    "../scripts/actions bt connect yes " + 
                                    (.mac_addr | tostring)
                                else
                                    "../scripts/actions bt connect no " + 
                                    (.mac_addr | tostring)
                                end
                                ','r')}"
                                (label
                                    :text "Connect"
                                )
                            )
                        )
                    )
                )
            )
        )
    )
    )
)
;}}}

; CAVA {{{
(defwidget cava []
    (box
        :class "cava"
        (for idx in "${CAVA}"
            (progress
                :class "cava-progress"
                :orientation 'v'
                :flipped true
                :value "${max(idx,2)}"
            )
        )
    )
)
;}}}
